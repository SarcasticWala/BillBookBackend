NODE_ENV=development
PORT=5000

# Comma-separated allowed frontend origins for CORS.
# Include your live frontend URL in production, e.g.:
# https://bill-book-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Comma-separated phone numbers (E.164, e.g. +919800054895) granted admin access
ADMIN_PHONES=

# MongoDB connection string — used ONLY when NODE_ENV=production (required
# there, throws on boot if missing). Leave unset for local dev.
# MONGO_URI=mongodb+srv://...

# Local/dev MongoDB — used whenever NODE_ENV is anything other than
# "production" (dev, test, missing/unknown). Defaults to the value below if
# not set, so local dev can never accidentally point at production.
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/billbook

# --- Local dev login (npm run seed) ---
# `npm run seed` creates this login so you can sign in locally without going
# through the email OTP flow. Never seeded when NODE_ENV=production. Optional
# — defaults shown below if left unset.
# SEED_USER_EMAIL=dev@local.test
# SEED_USER_PASSWORD=Password123!
# SEED_USER_PHONE=+911234567890

# --- Feature flags (new modules ship dark; "true" or "1" to enable) ---
# POS Billing, Automated Bills, and GST e-Invoicing are all in development —
# leave these off in production until each module is ready to launch.
FEATURE_SCHEDULER=false
FEATURE_POS_BILLING=false
FEATURE_AUTOMATED_BILLS=false
FEATURE_E_INVOICING=false

# --- GST e-Invoicing ---
# "MOCK" (default) simulates realistic IRN/QR responses for development —
# switch to "NIC" only once real NIC e-invoice API credentials are set below.
EINVOICE_PROVIDER=MOCK
# Informational only (shown in the UI) — this app doesn't track turnover.
EINVOICE_TURNOVER_THRESHOLD_CR=5
# Real NIC e-invoice API credentials — leave unset while using MOCK. Never
# commit real values here.
EINVOICE_NIC_GSTIN=
EINVOICE_NIC_USERNAME=
EINVOICE_NIC_PASSWORD=
EINVOICE_NIC_CLIENT_ID=
EINVOICE_NIC_CLIENT_SECRET=

# JWT — backend-issued session tokens
JWT_SECRET=your-long-random-secret
JWT_EXPIRES_IN=7d

# --- Email (OTP delivery) ---
# Preferred: Brevo HTTPS API (one API key, no OAuth, works on Render).
# Sign up free at brevo.com, verify SMTP_FROM as a sender, create an API key.
BREVO_API_KEY=
# Alternative: Gmail API over HTTPS (OAuth2) — also works on Render.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Sender address (your Gmail) — used as the "From" for Gmail API and SMTP.
SMTP_FROM=youraddress@gmail.com
# Fallback for LOCAL dev only (Gmail app password). SMTP is blocked on Render.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary (item image storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Docker Compose only (docker-compose.yml) ---
# Host ports the containers are published on, and the URL baked into the
# frontend build. Not read by the app itself — only by `docker compose`.
MONGO_PORT=27017
BACKEND_PORT=5000
FRONTEND_PORT=8080
VITE_API_BASE_URL=http://localhost:5000
